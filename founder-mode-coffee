private_path() {
  local path="$1" part
  [[ "$path" == /* && "$path" != *'/../'* && "$path" != */.. ]] || return 1
  part="$path"
  while [[ "$part" != / ]]; do
    [[ ! -L "$part" ]] || return 1
    part="${part%/*}"; [[ -n "$part" ]] || part=/
  done
}

file_metadata() {
  # BSD stat (macOS) and GNU stat; no platform-specific runtime dependency.
  local metadata
  if metadata="$(stat -f '%Lp %l' "$1" 2>/dev/null)"; then printf '%s\n' "$metadata"
  else stat -c '%a %h' "$1" 2>/dev/null; fi
}

prepare_history() {
  local dir="$DATA_HOME/.history"
  if [[ "${FMC_NO_HISTORY:-0}" == 1 ]]; then
    HISTORY_PATH=""
    unset HISTFILE
    HISTSIZE=500
    set +o history
    history -c
    return 0
  fi
  HISTORY_PATH="$dir/commands"
  private_path "$HISTORY_PATH" || return 1
  (umask 077; mkdir -p "$dir") || return 1
  [[ -d "$dir" && -O "$dir" && "$(file_metadata "$dir")" == 700\ * ]] || return 1
  if [[ ! -e "$HISTORY_PATH" ]]; then
    (umask 077; set -C; : > "$HISTORY_PATH") || return 1
  fi
  safe_history || return 1
  HISTFILE="$HISTORY_PATH" HISTSIZE=500 HISTFILESIZE=500
  export HISTFILE HISTSIZE HISTFILESIZE
  set +o history
  history -c
  history -r "$HISTORY_PATH"
}

safe_history() {
  private_path "$HISTORY_PATH" && [[ -f "$HISTORY_PATH" && -O "$HISTORY_PATH" && "$(file_metadata "$HISTORY_PATH")" == '600 1' ]] || return 1
  [[ $(wc -c < "$HISTORY_PATH") -le 1048576 ]]
}

save_history() {
  if [[ "${FMC_NO_HISTORY:-0}" == 1 ]]; then history -s -- "$1"; return 0; fi
  safe_history || { printf 'Error: unsafe history destination; refusing write.\n' >&2; return 1; }
  history -s -- "$1"
  history -w "$HISTORY_PATH"
}

interactive_dispatch() {
  local line="$1" word text
  local -a args
  word="${line%%[[:space:]]*}"
  text="${line#"$word"}"
  text="${text#"${text%%[![:space:]]*}"}"
  word="${word#/}"
  IFS=$' \t' read -r -a args <<< "$text"
  case "$word" in
    "") return 0 ;;
    online)
      [[ -z "$text" ]] || { printf 'Usage: online\n' >&2; return 2; }
      run_online ;;
    offline)
      [[ -z "$text" ]] || { printf 'Usage: offline\n' >&2; return 2; }
      run_offline ;;
    network)
      [[ -z "$text" || "$text" == --json ]] || { printf 'Usage: network [--json]\n' >&2; return 2; }
      local MODE="$text"
      run_network ;;
    capture) run_capture "$text" ;;
    focus)
      case "$text" in
        show|clear) run_focus "$text" ;;
        set\ *) run_focus set "${text#set }" ;;
        *) run_focus set "$text" ;;
      esac ;;
    ask) [[ -z "$text" ]] || run_ask "$text" ;;
    prompt) run_prompt "$text" ;;
    help) if [[ -z "$text" ]]; then show_interactive_help; else show_command_help "$text"; fi ;;
    clear)
      [[ -z "$NO_COLOR" ]] && printf '\033[2J\033[H'
      show_coffee_art; run_today ;;
    quit|exit) return 99 ;;
    today|done|me|checkin|net|update|ping|doctor|status|config|completion|hello)
      "$BASH" "${BASH_SOURCE[0]}" "$word" ${args[@]+"${args[@]}"} &
      REQUEST_PID=$!
      local result=0
      wait "$REQUEST_PID" || result=$?
      REQUEST_PID=""
      return "$result" ;;
    *)
      if [[ "$line" == /* ]]; then printf 'Unknown interactive command: %s\n' "$line" >&2
      else run_ask "$line"; fi ;;
  esac
}

run_interactive() {
  local line read_status dispatch_status
  NO_COLOR="${NO_COLOR:-}"
  HISTORY_PATH=""
  if [[ -t 0 ]]; then
    prepare_history || { printf 'Error: unsafe history destination.\n' >&2; return 1; }
    bind 'set enable-bracketed-paste off' 2>/dev/null || true
  fi
  umask 077
  SESSION_DIR="$(mktemp -d "${TMPDIR:-/tmp}/fmc-session.XXXXXX")" || return 1
  trap 'runtime_cleanup' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  if [[ -n "${FMC_TEST_HEARTBEAT_SECONDS:-}" ]]; then
    if [[ ! "$FMC_TEST_HEARTBEAT_SECONDS" =~ ^([1-9]|[1-5][0-9]|60)$ ]]; then
      printf 'Error: FMC_TEST_HEARTBEAT_SECONDS must be an integer from 1 to 60.\n' >&2; return 2
    fi
    HEARTBEAT_SECONDS="$FMC_TEST_HEARTBEAT_SECONDS"
  fi
  [[ "${1:-}" != online ]] || run_online || return 1
  update_accent
  show_coffee_art
  run_today || return 1
  printf '\nType help for commands (/help also works). Unknown text goes to AI.\n'
  while :; do
    update_accent
    printf '\n%bfmc> %b' "$ACCENT" "$RESET"
    read_status=0
    if [[ -t 0 ]]; then IFS= read -e -r line || read_status=$?
    else IFS= read -r line || read_status=$?; fi
    if [[ $read_status -ne 0 && -z "$line" ]]; then
      printf '\nSession closed.\n'
      return 0
    fi
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    report_availability
    if [[ -n "$line" && -t 0 ]]; then save_history "$line" || return 1; fi
    dispatch_status=0
    interactive_dispatch "$line" || dispatch_status=$?
    if [[ $dispatch_status -eq 99 ]]; then
      printf 'Session closed.\n'; return 0
    fi
    if [[ $read_status -ne 0 ]]; then
      printf 'Session closed.\n'
      return 0
    fi
  done
}

