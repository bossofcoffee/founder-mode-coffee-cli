#!/usr/bin/env bash
set -u

PROGRAM="founder-mode-coffee"
VERSION="2.1.0"
AMBER=""
GREEN=""
BOLD=""
RESET=""

init_colors() {
  if [[ -z "${NO_COLOR:-}" && ( -t 1 || "${FMC_FORCE_COLOR:-0}" == "1" ) ]]; then
    AMBER=$'\033[38;2;245;158;11m'
    GREEN=$'\033[38;2;34;197;94m'
    BOLD=$'\033[1m'
    RESET=$'\033[0m'
  fi
}

show_help() {
  cat <<'EOF'
Founder Mode Coffee
Coffee for people building companies.

Usage: founder-mode-coffee [global options] <command> [command options]

Commands:
  capture TEXT           Save a task, idea, or commitment locally
  focus <action>         Set or show the current outcome
  today                  Show the current focus and open work
  done ID                Complete and archive an open item
  prompt TEXT            Build an AI prompt from current context
  ask TEXT               Send current context to an AI runner
  hello                  Show the Founder Mode Coffee welcome
  ping                   Check in with FMC HQ
  status                 Show local CLI status
  doctor                 Check the local setup and API connection
  config                 Read or change CLI configuration
  completion             Generate shell completion
  update                 Check for a newer CLI release
  help [command]          Show help

Global options:
  --json                 Print machine-readable JSON
  --no-color             Disable color output
  -h, --help             Show help
  -V, --version          Show version
EOF
}

show_command_help() {
  case "${1:-}" in
    "") show_help ;;
    capture) cat <<'EOF'
Usage: founder-mode-coffee capture TEXT

Save one task, idea, or commitment in the local inbox.
EOF
      ;;
    focus) cat <<'EOF'
Usage: founder-mode-coffee focus <set TEXT|show|clear>

Set, show, or clear the one outcome that matters now.
EOF
      ;;
    today) cat <<'EOF'
Usage: founder-mode-coffee today [--json]

Show the current focus and open captured work.
EOF
      ;;
    done) cat <<'EOF'
Usage: founder-mode-coffee done ID

Complete an open item and retain it in the local archive.
EOF
      ;;
    prompt) cat <<'EOF'
Usage: founder-mode-coffee prompt TEXT

Print an AI-ready request containing the current focus and open work.
EOF
      ;;
    ask) cat <<'EOF'
Usage: founder-mode-coffee ask TEXT

Send the generated prompt to FMC_AI_RUNNER. Set the runner to "hermes" for
Hermes Agent, or to an executable that reads the prompt from standard input.
EOF
      ;;
    ping) cat <<'EOF'
Usage: founder-mode-coffee ping [--json]

Send one check-in to FMC HQ. The command has short network timeouts and returns
non-zero when the API cannot be reached.
EOF
      ;;
    status) cat <<'EOF'
Usage: founder-mode-coffee status [--json]

Show the CLI version, resolved API endpoint, and config path.
EOF
      ;;
    doctor) cat <<'EOF'
Usage: founder-mode-coffee doctor [--json]

Check curl, config-directory access, and the FMC API connection.
EOF
      ;;
    config) cat <<'EOF'
Usage: founder-mode-coffee config <get api|set api URL|path|reset>

FMC_API overrides the saved API URL for one command.
EOF
      ;;
    completion) cat <<'EOF'
Usage: founder-mode-coffee completion <bash|zsh|fish>

Print a completion script to standard output.
EOF
      ;;
    update) cat <<'EOF'
Usage: founder-mode-coffee update [--json]

Compare this CLI version with the latest GitHub release.
EOF
      ;;
    hello) printf 'Usage: %s hello\n\nShow the Founder Mode Coffee welcome.\n' "$PROGRAM" ;;
    help) show_help ;;
    *) printf 'Error: no help for unknown command: %s\n' "$1" >&2; return 2 ;;
  esac
}

show_hello() {
  printf '\n%bFounder Mode Coffee%b\n' "$AMBER$BOLD" "$RESET"
  printf '%bCoffee for people building companies.%b\n\n' "$GREEN" "$RESET"
  printf 'The first roast is in development: https://foundermodecoffee.com\n\n'
}

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/founder-mode-coffee"
CONFIG_FILE="$CONFIG_HOME/config"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/founder-mode-coffee"
INBOX_DIR="$DATA_HOME/inbox"
COMPLETED_DIR="$DATA_HOME/completed"
COUNTER_FILE="$DATA_HOME/next-id"
FOCUS_FILE="$DATA_HOME/focus"
DEFAULT_API="https://foundermodecoffee.com/api"

config_path_accessible() {
  local path="$CONFIG_HOME"
  local parent
  case "$path" in
    /*) ;;
    *) path="$PWD/$path" ;;
  esac
  while [[ ! -e "$path" ]]; do
    parent="${path%/*}"
    [[ -n "$parent" ]] || parent="/"
    [[ "$parent" != "$path" ]] || return 1
    path="$parent"
  done
  [[ -d "$path" && -x "$path" ]]
}

valid_ipv4() {
  local value="$1" octet i
  local -a octets
  IFS=. read -r -a octets <<< "$value"
  ((${#octets[@]} == 4)) || return 1
  for i in 0 1 2 3; do
    octet="${octets[$i]}"
    [[ "$octet" =~ ^[0-9]+$ && ${#octet} -le 3 ]] || return 1
    ((10#$octet <= 255)) || return 1
  done
}

IPV6_SIDE_COUNT=0
valid_ipv6_side() {
  local value="$1" allow_ipv4="$2" group i
  local -a groups
  IPV6_SIDE_COUNT=0
  [[ -n "$value" ]] || return 0
  [[ "$value" != :* && "$value" != *: ]] || return 1
  IFS=: read -r -a groups <<< "$value"
  for ((i = 0; i < ${#groups[@]}; i++)); do
    group="${groups[$i]}"
    if [[ "$group" == *.* ]]; then
      [[ "$allow_ipv4" == true && $i -eq $((${#groups[@]} - 1)) ]] || return 1
      valid_ipv4 "$group" || return 1
      IPV6_SIDE_COUNT=$((IPV6_SIDE_COUNT + 2))
    else
      [[ "$group" =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
      IPV6_SIDE_COUNT=$((IPV6_SIDE_COUNT + 1))
    fi
  done
}

valid_ipv6() {
  local value="$1" left right total
  [[ -n "$value" && "$value" =~ ^[0-9A-Fa-f:.]+$ ]] || return 1
  if [[ "$value" == *::* ]]; then
    left="${value%%::*}"
    right="${value#*::}"
    [[ "$right" != *::* ]] || return 1
    valid_ipv6_side "$left" false || return 1
    total=$IPV6_SIDE_COUNT
    valid_ipv6_side "$right" true || return 1
    total=$((total + IPV6_SIDE_COUNT))
    ((total < 8))
  else
    valid_ipv6_side "$value" true || return 1
    ((IPV6_SIDE_COUNT == 8))
  fi
}

valid_port() {
  local port="$1"
  [[ "$port" =~ ^[0-9]+$ ]] || return 1
  while [[ ${#port} -gt 1 && "$port" == 0* ]]; do
    port="${port#0}"
  done
  [[ ${#port} -le 5 ]] || return 1
  ((10#$port >= 1 && 10#$port <= 65535))
}

valid_hostname() {
  local host="$1" label i
  local -a labels
  [[ -n "$host" && ${#host} -le 253 ]] || return 1
  if [[ "$host" =~ ^[0-9.]+$ ]]; then
    valid_ipv4 "$host"
    return
  fi
  [[ "$host" != .* && "$host" != *. && "$host" != *..* ]] || return 1
  IFS=. read -r -a labels <<< "$host"
  for ((i = 0; i < ${#labels[@]}; i++)); do
    label="${labels[$i]}"
    [[ ${#label} -le 63 && "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] || return 1
  done
}

valid_api_url() {
  local value="$1" authority host port remainder
  case "$value" in
    http://*) authority="${value#http://}" ;;
    https://*) authority="${value#https://}" ;;
    *) return 1 ;;
  esac
  case "$value" in
    *[[:space:][:cntrl:]]*) return 1 ;;
    *\?*|*\#*) return 1 ;;
  esac
  authority="${authority%%/*}"
  [[ -n "$authority" ]] || return 1
  if [[ "$authority" == \[* ]]; then
    remainder="${authority#\[}"
    [[ "$remainder" == *\]* ]] || return 1
    host="${remainder%%\]*}"
    remainder="${remainder#*\]}"
    [[ "$remainder" != *\]* ]] || return 1
    valid_ipv6 "$host" || return 1
    if [[ -n "$remainder" ]]; then
      [[ "$remainder" == :* ]] || return 1
      port="${remainder#:}"
      valid_port "$port" || return 1
    fi
  else
    [[ "$authority" != *\[* && "$authority" != *\]* && "$authority" != *:*:* ]] || return 1
    host="${authority%%:*}"
    valid_hostname "$host" || return 1
    if [[ "$authority" == *:* ]]; then
      port="${authority#*:}"
      valid_port "$port" || return 1
    fi
  fi
}

config_api() {
  local line
  if ! config_path_accessible; then
    printf 'Error: config path is not accessible: %s\n' "$CONFIG_FILE" >&2
    return 1
  fi
  if [[ -e "$CONFIG_FILE" ]]; then
    if [[ ! -f "$CONFIG_FILE" || ! -r "$CONFIG_FILE" ]]; then
      printf 'Error: config file is not readable: %s\n' "$CONFIG_FILE" >&2
      return 1
    fi
    while IFS= read -r line; do
      case "$line" in
        api=*)
          line="${line#api=}"
          if ! valid_api_url "$line"; then
            printf 'Error: saved API URL is invalid.\n' >&2
            return 1
          fi
          printf '%s\n' "${line%/}"
          return 0
          ;;
      esac
    done < "$CONFIG_FILE"
  fi
  printf '%s\n' "$DEFAULT_API"
}

resolved_api() {
  if [[ -n "${FMC_API:-}" ]]; then
    if ! valid_api_url "$FMC_API"; then
      printf 'Error: FMC_API must be a valid http:// or https:// URL.\n' >&2
      return 1
    fi
    printf '%s\n' "${FMC_API%/}"
  else
    config_api
  fi
}

json_escape() {
  local value="$1" control escaped i
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  i=1
  while ((i <= 31)); do
    printf -v control '%b' "\\$(printf '%03o' "$i")"
    case "$i" in
      8) escaped='\b' ;;
      9) escaped='\t' ;;
      10) escaped='\n' ;;
      12) escaped='\f' ;;
      13) escaped='\r' ;;
      *) printf -v escaped '\\u%04x' "$i" ;;
    esac
    value="${value//$control/$escaped}"
    ((i += 1))
  done
  control=$'\177'
  value="${value//$control/\\u007f}"
  printf '%s' "$value"
}

run_status() {
  local api
  api="$(resolved_api)" || return 1
  if [[ "${1:-}" == "--json" ]]; then
    printf '{"command":"status","version":"%s","api":"%s","config":"%s"}\n' \
      "$(json_escape "$VERSION")" "$(json_escape "$api")" "$(json_escape "$CONFIG_FILE")"
  else
    printf 'Founder Mode Coffee CLI\n'
    printf '  version  %s\n' "$VERSION"
    printf '  api      %s\n' "$api"
    printf '  config   %s\n' "$CONFIG_FILE"
  fi
}

json_top_value() {
  local key="$1"
  local kind="$2"
  LC_ALL=C awk -v wanted="$key" -v wanted_kind="$kind" '
    function byte(c) {
      return index(allbytes, c)
    }
    function raw_utf8(first,    lead, needed, min_second, max_second, i, c, octet) {
      lead = byte(first)
      if (lead >= 194 && lead <= 223) {
        needed = 1; min_second = 128; max_second = 191
      } else if (lead == 224) {
        needed = 2; min_second = 160; max_second = 191
      } else if (lead >= 225 && lead <= 236) {
        needed = 2; min_second = 128; max_second = 191
      } else if (lead == 237) {
        needed = 2; min_second = 128; max_second = 159
      } else if (lead >= 238 && lead <= 239) {
        needed = 2; min_second = 128; max_second = 191
      } else if (lead == 240) {
        needed = 3; min_second = 144; max_second = 191
      } else if (lead >= 241 && lead <= 243) {
        needed = 3; min_second = 128; max_second = 191
      } else if (lead == 244) {
        needed = 3; min_second = 128; max_second = 143
      } else return 0
      if (p + needed - 1 > n) return 0
      sval = sval first
      for (i = 1; i <= needed; i++) {
        c = substr(s, p, 1)
        octet = byte(c)
        if (i == 1) {
          if (octet < min_second || octet > max_second) return 0
        } else if (octet < 128 || octet > 191) return 0
        sval = sval c
        p++
      }
      return 1
    }
    function ws() {
      while (p <= n && substr(s, p, 1) ~ /[ \t\r\n]/) p++
    }
    function hex_number(text,    i, digit, result) {
      result = 0
      for (i = 1; i <= length(text); i++) {
        digit = index("0123456789abcdef", tolower(substr(text, i, 1))) - 1
        if (digit < 0) return -1
        result = result * 16 + digit
      }
      return result
    }
    function utf8(code) {
      if (code <= 127) return sprintf("%c", code)
      if (code <= 2047) return sprintf("%c%c", 192 + int(code / 64), 128 + code % 64)
      if (code <= 65535) return sprintf("%c%c%c", 224 + int(code / 4096), 128 + int(code / 64) % 64, 128 + code % 64)
      return sprintf("%c%c%c%c", 240 + int(code / 262144), 128 + int(code / 4096) % 64, 128 + int(code / 64) % 64, 128 + code % 64)
    }
    function string(    c, e, hex, lowhex, code, low, count, octet) {
      if (substr(s, p, 1) != "\"") return 0
      p++
      sval = ""
      count = 0
      while (p <= n) {
        c = substr(s, p++, 1)
        if (c == "\"") {
          snonempty = (count > 0)
          return 1
        }
        if (c != "\\") {
          octet = byte(c)
          if (octet == 0 || (octet >= 1 && octet <= 31)) return 0
          if (octet >= 128 && !raw_utf8(c)) return 0
          if (octet <= 127) sval = sval c
          count++
          continue
        }
        if (p > n) return 0
        e = substr(s, p++, 1)
        if (e == "u") {
          hex = substr(s, p, 4)
          if (length(hex) != 4 || hex !~ /^[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]$/) return 0
          code = hex_number(hex)
          p += 4
          if (code >= 55296 && code <= 56319) {
            if (substr(s, p, 2) != "\\u") return 0
            lowhex = substr(s, p + 2, 4)
            if (length(lowhex) != 4 || lowhex !~ /^[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]$/) return 0
            low = hex_number(lowhex)
            if (low < 56320 || low > 57343) return 0
            code = 65536 + (code - 55296) * 1024 + low - 56320
            p += 6
          } else if (code >= 56320 && code <= 57343) return 0
          sval = sval utf8(code)
        } else if (e == "\"" || e == "\\" || e == "/") sval = sval e
        else if (e == "b") sval = sval sprintf("%c", 8)
        else if (e == "f") sval = sval sprintf("%c", 12)
        else if (e == "n") sval = sval "\n"
        else if (e == "r") sval = sval "\r"
        else if (e == "t") sval = sval "\t"
        else return 0
        count++
      }
      return 0
    }
    function value(    rest) {
      ws()
      if (substr(s, p, 1) == "{") return object(0)
      if (substr(s, p, 1) == "[") return array()
      if (substr(s, p, 1) == "\"") return string()
      rest = substr(s, p)
      if (match(rest, /^-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?/)) {
        p += RLENGTH
        return 1
      }
      if (substr(s, p, 4) == "true" || substr(s, p, 4) == "null") { p += 4; return 1 }
      if (substr(s, p, 5) == "false") { p += 5; return 1 }
      return 0
    }
    function object(top,    key, rest) {
      if (substr(s, p, 1) != "{") return 0
      p++
      ws()
      if (substr(s, p, 1) == "}") { p++; return 1 }
      while (p <= n) {
        if (!string()) return 0
        key = sval
        ws()
        if (substr(s, p, 1) != ":") return 0
        p++
        ws()
        if (top && key == wanted) {
          if (seen_target) return 0
          if (wanted_kind == "string") {
            if (!string() || !snonempty) return 0
            target = sval
          } else if (wanted_kind == "uint") {
            rest = substr(s, p)
            if (!match(rest, /^(0|[1-9][0-9]*)/)) return 0
            target = substr(rest, 1, RLENGTH)
            p += RLENGTH
          } else return 0
          seen_target = 1
        } else if (!value()) return 0
        ws()
        if (substr(s, p, 1) == "}") { p++; return 1 }
        if (substr(s, p, 1) != ",") return 0
        p++
        ws()
      }
      return 0
    }
    function array() {
      if (substr(s, p, 1) != "[") return 0
      p++
      ws()
      if (substr(s, p, 1) == "]") { p++; return 1 }
      while (p <= n) {
        if (!value()) return 0
        ws()
        if (substr(s, p, 1) == "]") { p++; return 1 }
        if (substr(s, p, 1) != ",") return 0
        p++
      }
      return 0
    }
    BEGIN {
      for (i = 1; i <= 255; i++) allbytes = allbytes sprintf("%c", i)
    }
    { s = s (NR > 1 ? "\n" : "") $0 }
    END {
      n = length(s)
      p = 1
      ws()
      if (!object(1)) exit 1
      ws()
      if (p != n + 1 || !seen_target) exit 1
      printf "%s", target
    }
  '
}

json_top_string() {
  json_top_value "$1" string
}

json_top_uint() {
  json_top_value "$1" uint
}

JSON_VALUE=""
capture_json_top_value() {
  local file="$1" key="$2" kind="$3" marker captured status
  marker=$'\036'
  if ! captured="$({
    json_top_value "$key" "$kind" < "$file"
    status=$?
    printf '%s' "$marker"
    exit "$status"
  })"; then
    return 1
  fi
  JSON_VALUE="${captured%"$marker"}"
}

run_ping() {
  local mode="${1:-}"
  local api response_file error_file detail message total timestamp
  api="$(resolved_api)" || return 1
  command -v curl >/dev/null 2>&1 || {
    if [[ "$mode" == "--json" ]]; then
      printf '{"error":"curl is required"}\n'
    else
      printf 'Error: curl is required for ping.\n' >&2
    fi
    return 1
  }
  response_file="$(mktemp "${TMPDIR:-/tmp}/fmc-ping-response.XXXXXX")" || return 1
  error_file="$(mktemp "${TMPDIR:-/tmp}/fmc-ping-error.XXXXXX")" || {
    rm -f "$response_file"
    return 1
  }
  if ! curl --globoff --fail --silent --show-error --connect-timeout 5 --max-time 15 -X POST -- "$api/ping" \
      >"$response_file" 2>"$error_file"; then
    detail="$(<"$error_file")"
    rm -f "$response_file" "$error_file"
    if [[ "$mode" == "--json" ]]; then
      printf '{"error":"%s","endpoint":"%s"}\n' "$(json_escape "${detail:-connection failed}")" "$(json_escape "$api/ping")"
    else
      printf 'Error: could not reach FMC HQ at %s.\n' "$api" >&2
      [[ -n "$detail" ]] && printf '  %s\n' "$detail" >&2
    fi
    return 1
  fi
  rm -f "$error_file"

  if [[ "$mode" == "--json" ]]; then
    if ! json_top_string message < "$response_file" >/dev/null; then
      rm -f "$response_file"
      printf '{"error":"FMC HQ returned an unexpected response","endpoint":"%s"}\n' "$(json_escape "$api/ping")"
      return 1
    fi
    command cat "$response_file"
    rm -f "$response_file"
    return 0
  fi

  if capture_json_top_value "$response_file" message string; then
    message="$JSON_VALUE"
  else
    message=""
  fi
  if capture_json_top_value "$response_file" total_pings uint; then
    total="$JSON_VALUE"
  else
    total=""
  fi
  if capture_json_top_value "$response_file" timestamp string; then
    timestamp="$JSON_VALUE"
  else
    timestamp=""
  fi
  rm -f "$response_file"
  if [[ -z "$message" ]]; then
    printf 'Error: FMC HQ returned an unexpected response.\n' >&2
    return 1
  fi
  printf '%s\n' "$message"
  [[ -n "$total" ]] && printf 'Ping %s\n' "$total"
  [[ -n "$timestamp" ]] && printf '%s\n' "$timestamp"
  return 0
}

run_doctor() {
  local mode="${1:-}"
  local api curl_ok=false config_ok=false api_ok=false probe
  api="$(resolved_api)" || return 1
  command -v curl >/dev/null 2>&1 && curl_ok=true
  if mkdir -p "$CONFIG_HOME" 2>/dev/null; then
    probe="$(mktemp "$CONFIG_HOME/.doctor.XXXXXX" 2>/dev/null || true)"
    if [[ -n "$probe" ]]; then
      config_ok=true
      rm -f "$probe"
    fi
  fi
  if [[ "$curl_ok" == true ]] && curl --globoff --fail --silent --show-error --connect-timeout 5 --max-time 10 -- "$api/pings/locations" >/dev/null 2>&1; then
    api_ok=true
  fi
  if [[ "$mode" == "--json" ]]; then
    printf '{"curl":%s,"config_writable":%s,"api":%s,"endpoint":"%s"}\n' \
      "$curl_ok" "$config_ok" "$api_ok" "$(json_escape "$api")"
  else
    [[ "$curl_ok" == true ]] && printf '[ok] curl\n' || printf '[fail] curl is not installed\n'
    [[ "$config_ok" == true ]] && printf '[ok] config directory\n' || printf '[fail] config directory is not writable\n'
    [[ "$api_ok" == true ]] && printf '[ok] API %s\n' "$api" || printf '[fail] API %s\n' "$api"
  fi
  [[ "$curl_ok" == true && "$config_ok" == true && "$api_ok" == true ]]
}

release_capture_claim() {
  local claim="$1" expected_owner="$2" owner=""
  if [[ -f "$claim" ]]; then
    IFS= read -r owner < "$claim" || true
  fi
  if [[ "$owner" == "$expected_owner" ]]; then
    rm -f "$claim" 2>/dev/null || true
  fi
}

run_capture() {
  local text="$*" next_id=1 item_name claim_file claim_owner claim_seed stale_claim temp_counter temp_item
  [[ -n "$text" ]] || { printf 'Usage: %s capture TEXT\n' "$PROGRAM" >&2; return 2; }
  case "$text" in
    *$'\n'*|*$'\r'*) printf 'Error: capture accepts one line of text.\n' >&2; return 2 ;;
  esac
  if ! mkdir -p "$INBOX_DIR" 2>/dev/null; then
    printf 'Error: could not create productivity data directory: %s\n' "$INBOX_DIR" >&2
    return 1
  fi
  if [[ -e "$COUNTER_FILE" ]]; then
    [[ -f "$COUNTER_FILE" && -r "$COUNTER_FILE" ]] || {
      printf 'Error: productivity counter is not readable: %s\n' "$COUNTER_FILE" >&2
      return 1
    }
    IFS= read -r next_id < "$COUNTER_FILE" || true
    if [[ "$next_id" == "100000000" ]]; then
      printf 'Error: productivity item IDs are exhausted.\n' >&2
      return 1
    fi
    [[ "$next_id" =~ ^[1-9][0-9]*$ && ${#next_id} -le 8 ]] || {
      printf 'Error: productivity counter is invalid: %s\n' "$COUNTER_FILE" >&2
      return 1
    }
  fi
  claim_seed="$(mktemp "$INBOX_DIR/.claim-owner.XXXXXX" 2>/dev/null)" || {
    printf 'Error: could not create capture claim.\n' >&2
    return 1
  }
  printf '%s\n' "$$" > "$claim_seed" || { rm -f "$claim_seed"; return 1; }
  while :; do
    [[ ${#next_id} -le 8 ]] || {
      rm -f "$claim_seed"
      printf 'Error: productivity item IDs are exhausted.\n' >&2
      return 1
    }
    printf -v item_name '%08d' "$next_id"
    claim_file="$INBOX_DIR/.$item_name.claim"
    if ln "$claim_seed" "$claim_file" 2>/dev/null; then
      rm -f "$claim_seed"
      if [[ ! -e "$INBOX_DIR/$item_name" && ! -e "$COMPLETED_DIR/$item_name" ]]; then
        break
      fi
      release_capture_claim "$claim_file" "$$"
      claim_seed="$(mktemp "$INBOX_DIR/.claim-owner.XXXXXX")" || return 1
      printf '%s\n' "$$" > "$claim_seed" || { rm -f "$claim_seed"; return 1; }
    elif [[ -d "$claim_file" ]]; then
      rmdir "$claim_file" 2>/dev/null && continue
    else
      claim_owner=""
      if [[ -f "$claim_file" ]]; then
        IFS= read -r claim_owner < "$claim_file" || true
      fi
      if [[ "$claim_owner" =~ ^[1-9][0-9]*$ ]] && ! kill -0 "$claim_owner" 2>/dev/null; then
        stale_claim="$claim_file.stale.$$"
        if mv "$claim_file" "$stale_claim" 2>/dev/null; then
          rm -f "$stale_claim"
          continue
        fi
      fi
    fi
    next_id=$((next_id + 1))
  done
  temp_item="$(mktemp "$INBOX_DIR/.capture.XXXXXX" 2>/dev/null)" || {
    release_capture_claim "$claim_file" "$$"
    printf 'Error: could not create a captured item.\n' >&2
    return 1
  }
  if ! printf '%s\n' "$text" > "$temp_item"; then
    rm -f "$temp_item"
    release_capture_claim "$claim_file" "$$"
    printf 'Error: could not write captured item.\n' >&2
    return 1
  fi
  temp_counter="$(mktemp "$DATA_HOME/.next-id.XXXXXX" 2>/dev/null)" || {
    rm -f "$temp_item"
    release_capture_claim "$claim_file" "$$"
    printf 'Error: could not update productivity counter.\n' >&2
    return 1
  }
  if ! printf '%s\n' "$((next_id + 1))" > "$temp_counter" || ! mv "$temp_counter" "$COUNTER_FILE"; then
    rm -f "$temp_item" "$temp_counter"
    release_capture_claim "$claim_file" "$$"
    printf 'Error: could not update productivity counter.\n' >&2
    return 1
  fi
  if ! mv "$temp_item" "$INBOX_DIR/$item_name"; then
    rm -f "$temp_item"
    release_capture_claim "$claim_file" "$$"
    printf 'Error: could not save captured item.\n' >&2
    return 1
  fi
  release_capture_claim "$claim_file" "$$"
  printf 'Captured #%s: %s\n' "$next_id" "$text"
}

RECORD_VALUE=""
read_productivity_record() {
  local path="$1" label="$2" line count=0
  RECORD_VALUE=""
  [[ -f "$path" && ! -L "$path" && -r "$path" ]] || {
    printf 'Error: %s is not a readable local record: %s\n' "$label" "$path" >&2
    return 1
  }
  while IFS= read -r line || [[ -n "$line" ]]; do
    count=$((count + 1))
    [[ $count -eq 1 ]] || {
      printf 'Error: %s must contain exactly one line: %s\n' "$label" "$path" >&2
      return 1
    }
    RECORD_VALUE="$line"
  done < "$path"
  [[ $count -eq 1 && -n "$RECORD_VALUE" ]] || {
    printf 'Error: %s must contain one non-empty line: %s\n' "$label" "$path" >&2
    return 1
  }
}

validate_productivity_state() {
  local path
  if [[ -e "$FOCUS_FILE" ]]; then
    read_productivity_record "$FOCUS_FILE" "focus" || return 1
  fi
  for path in "$INBOX_DIR"/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]; do
    [[ -e "$path" ]] || continue
    read_productivity_record "$path" "open item" || return 1
  done
}

run_done() {
  local id="$1" item_name item_path archive_claim text
  [[ "$id" =~ ^[1-9][0-9]*$ && ${#id} -le 8 ]] || {
    printf 'Error: item ID must be a positive integer.\n' >&2
    return 2
  }
  printf -v item_name '%08d' "$id"
  item_path="$INBOX_DIR/$item_name"
  if [[ ! -f "$item_path" || ! -r "$item_path" ]]; then
    printf 'Error: open item #%s was not found.\n' "$id" >&2
    return 1
  fi
  read_productivity_record "$item_path" "open item" || return 1
  text="$RECORD_VALUE"
  mkdir -p "$COMPLETED_DIR" 2>/dev/null || {
    printf 'Error: could not create completed-item directory: %s\n' "$COMPLETED_DIR" >&2
    return 1
  }
  archive_claim="$COMPLETED_DIR/.$item_name.claim"
  if ! mkdir "$archive_claim" 2>/dev/null; then
    printf 'Error: item #%s is already being completed.\n' "$id" >&2
    return 1
  fi
  if [[ -e "$COMPLETED_DIR/$item_name" ]]; then
    rmdir "$archive_claim" 2>/dev/null || true
    printf 'Error: archived item #%s already exists.\n' "$id" >&2
    return 1
  fi
  if ! mv "$item_path" "$COMPLETED_DIR/$item_name"; then
    rmdir "$archive_claim" 2>/dev/null || true
    printf 'Error: could not complete item #%s.\n' "$id" >&2
    return 1
  fi
  rmdir "$archive_claim" 2>/dev/null || true
  printf 'Completed #%s: %s\n' "$id" "$text"
}

run_focus() {
  local action="${1:-}" text temp_file
  case "$action" in
    set)
      shift
      text="$*"
      [[ -n "$text" ]] || { printf 'Usage: %s focus set TEXT\n' "$PROGRAM" >&2; return 2; }
      case "$text" in
        *$'\n'*|*$'\r'*) printf 'Error: focus accepts one line of text.\n' >&2; return 2 ;;
      esac
      mkdir -p "$DATA_HOME" 2>/dev/null || {
        printf 'Error: could not create productivity data directory: %s\n' "$DATA_HOME" >&2
        return 1
      }
      temp_file="$(mktemp "$DATA_HOME/.focus.XXXXXX" 2>/dev/null)" || {
        printf 'Error: could not create focus file.\n' >&2
        return 1
      }
      if ! printf '%s\n' "$text" > "$temp_file" || ! mv "$temp_file" "$FOCUS_FILE"; then
        rm -f "$temp_file"
        printf 'Error: could not save focus.\n' >&2
        return 1
      fi
      printf 'Focus set: %s\n' "$text"
      ;;
    show)
      if [[ -e "$FOCUS_FILE" ]]; then
        read_productivity_record "$FOCUS_FILE" "focus" || return 1
        printf '%s\n' "$RECORD_VALUE"
      else
        printf 'Not set\n'
      fi
      ;;
    clear)
      if ! rm -f "$FOCUS_FILE"; then
        printf 'Error: could not clear focus.\n' >&2
        return 1
      fi
      printf 'Focus cleared.\n'
      ;;
    *)
      printf 'Usage: %s focus <set TEXT|show|clear>\n' "$PROGRAM" >&2
      return 2
      ;;
  esac
}

run_today() {
  local mode="${1:-}" focus="Not set" path id text found=false first=true
  validate_productivity_state || return 1
  if [[ -e "$FOCUS_FILE" ]]; then
    read_productivity_record "$FOCUS_FILE" "focus" || return 1
    focus="$RECORD_VALUE"
  fi
  if [[ "$mode" == "--json" ]]; then
    printf '{"focus":"%s","open":[' "$(json_escape "$focus")"
    for path in "$INBOX_DIR"/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]; do
      [[ -f "$path" && -r "$path" ]] || continue
      id="${path##*/}"
      while [[ ${#id} -gt 1 && "$id" == 0* ]]; do id="${id#0}"; done
      read_productivity_record "$path" "open item" || return 1
    text="$RECORD_VALUE"
      [[ "$first" == true ]] || printf ','
      first=false
      printf '{"id":%s,"text":"%s"}' "$id" "$(json_escape "$text")"
    done
    printf ']}\n'
    return 0
  fi
  printf 'FOCUS  %s\n' "$focus"
  printf '\nOPEN\n'
  for path in "$INBOX_DIR"/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]; do
    [[ -f "$path" && -r "$path" ]] || continue
    found=true
    id="${path##*/}"
    while [[ ${#id} -gt 1 && "$id" == 0* ]]; do id="${id#0}"; done
    read_productivity_record "$path" "open item" || return 1
    text="$RECORD_VALUE"
    printf '  [%s] %s\n' "$id" "$text"
  done
  [[ "$found" == true ]] || printf '  Nothing captured.\n'
}

write_founder_prompt() {
  local request="$*" focus="Not set" path id text found=false
  [[ -n "$request" ]] || { printf 'Usage: %s prompt TEXT\n' "$PROGRAM" >&2; return 2; }
  validate_productivity_state || return 1
  if [[ -e "$FOCUS_FILE" ]]; then
    read_productivity_record "$FOCUS_FILE" "focus" || return 1
    focus="$RECORD_VALUE"
  fi
  cat <<'EOF'
Act as a practical operating partner for a founder.
Use only the context that matters. State any assumptions. Give a clear recommendation and the next concrete action. Keep the response concise.

Current focus:
EOF
  printf '%s\n\n' "$focus"
  printf 'Open work:\n'
  for path in "$INBOX_DIR"/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]; do
    [[ -f "$path" && -r "$path" ]] || continue
    found=true
    id="${path##*/}"
    while [[ ${#id} -gt 1 && "$id" == 0* ]]; do id="${id#0}"; done
    read_productivity_record "$path" "open item" || return 1
    text="$RECORD_VALUE"
    printf '[%s] %s\n' "$id" "$text"
  done
  [[ "$found" == true ]] || printf 'Nothing captured.\n'
  printf '\nRequest:\n%s\n' "$request"
}

run_prompt() {
  write_founder_prompt "$@"
}

AI_PROMPT_FILE=""
cleanup_ai_prompt() {
  [[ -n "$AI_PROMPT_FILE" ]] && rm -f "$AI_PROMPT_FILE"
  AI_PROMPT_FILE=""
}

run_ask() {
  local runner="${FMC_AI_RUNNER:-}" runner_path prompt_file status
  [[ -n "$runner" ]] || {
    printf 'Error: set FMC_AI_RUNNER to an executable that reads a prompt from stdin.\n' >&2
    printf 'Run "%s prompt TEXT" to generate the prompt without invoking AI.\n' "$PROGRAM" >&2
    return 1
  }
  case "$runner" in
    *$'\n'*|*$'\r'*|*[[:space:]]*)
      printf 'Error: FMC_AI_RUNNER must name one executable without arguments.\n' >&2
      return 2
      ;;
  esac
  runner_path="$(command -v "$runner" 2>/dev/null)" || {
    printf 'Error: AI runner was not found: %s\n' "$runner" >&2
    return 1
  }
  [[ -f "$runner_path" && -x "$runner_path" ]] || {
    printf 'Error: AI runner is not an executable file: %s\n' "$runner" >&2
    return 1
  }
  prompt_file="$(mktemp "${TMPDIR:-/tmp}/fmc-ai-prompt.XXXXXX")" || {
    printf 'Error: could not create AI prompt file.\n' >&2
    return 1
  }
  AI_PROMPT_FILE="$prompt_file"
  trap 'cleanup_ai_prompt' EXIT
  trap 'exit 1' HUP INT TERM
  write_founder_prompt "$@" > "$prompt_file"
  status=$?
  if [[ $status -ne 0 ]]; then
    cleanup_ai_prompt
    trap - EXIT HUP INT TERM
    return "$status"
  fi
  case "$runner" in
    hermes) "$runner_path" chat -q "$(<"$prompt_file")" ;;
    *) "$runner_path" < "$prompt_file" ;;
  esac
  status=$?
  cleanup_ai_prompt
  trap - EXIT HUP INT TERM
  if [[ $status -ne 0 ]]; then
    printf 'Error: AI runner exited with status %s.\n' "$status" >&2
    return 1
  fi
}

run_completion() {
  case "${1:-}" in
    bash)
      cat <<'EOF'
_founder_mode_coffee() {
  local current="${COMP_WORDS[COMP_CWORD]}"
  local commands="capture focus today done prompt ask hello ping status doctor config completion update help"
  COMPREPLY=( $(compgen -W "$commands --help --version --json --no-color" -- "$current") )
}
complete -F _founder_mode_coffee founder-mode-coffee
EOF
      ;;
    zsh)
      cat <<'EOF'
#compdef founder-mode-coffee
_founder-mode-coffee() {
  _arguments \
    '(-h --help)'{-h,--help}'[show help]' \
    '(-V --version)'{-V,--version}'[show version]' \
    '--json[print JSON]' \
    '--no-color[disable color]' \
    '1:command:(capture focus today done prompt ask hello ping status doctor config completion update help)'
}
_founder-mode-coffee "$@"
EOF
      ;;
    fish)
      cat <<'EOF'
complete -c founder-mode-coffee -f
complete -c founder-mode-coffee -s h -l help -d 'Show help'
complete -c founder-mode-coffee -s V -l version -d 'Show version'
complete -c founder-mode-coffee -l json -d 'Print JSON'
complete -c founder-mode-coffee -l no-color -d 'Disable color'
complete -c founder-mode-coffee -n '__fish_use_subcommand' -a 'capture focus today done prompt ask hello ping status doctor config completion update help'
EOF
      ;;
    *)
      printf 'Usage: %s completion <bash|zsh|fish>\n' "$PROGRAM" >&2
      return 2
      ;;
  esac
}

version_gt() {
  local LC_ALL=C
  local left="${1#v}" right="${2#v}" i av bv
  local -a a b
  IFS=. read -r -a a <<< "$left"
  IFS=. read -r -a b <<< "$right"
  for i in 0 1 2; do
    av="${a[$i]:-0}"
    bv="${b[$i]:-0}"
    ((${#av} > ${#bv})) && return 0
    ((${#av} < ${#bv})) && return 1
    [[ "$av" > "$bv" ]] && return 0
    [[ "$av" < "$bv" ]] && return 1
  done
  return 1
}

run_update() {
  local mode="${1:-}" response_file latest url available=false
  command -v curl >/dev/null 2>&1 || {
    [[ "$mode" == "--json" ]] && printf '{"error":"curl is required"}\n' || printf 'Error: curl is required for update checks.\n' >&2
    return 1
  }
  response_file="$(mktemp "${TMPDIR:-/tmp}/fmc-update-response.XXXXXX")" || {
    [[ "$mode" == "--json" ]] && printf '{"error":"update check failed"}\n' || printf 'Error: update check failed.\n' >&2
    return 1
  }
  if ! curl --globoff --fail --silent --show-error --connect-timeout 5 --max-time 15 -- \
      "https://api.github.com/repos/bossofcoffee/founder-mode-coffee-cli/releases/latest" > "$response_file"; then
    rm -f "$response_file"
    [[ "$mode" == "--json" ]] && printf '{"error":"update check failed"}\n' || printf 'Error: update check failed.\n' >&2
    return 1
  fi
  if capture_json_top_value "$response_file" tag_name string; then
    latest="$JSON_VALUE"
  else
    rm -f "$response_file"
    [[ "$mode" == "--json" ]] && printf '{"error":"GitHub returned an unexpected response"}\n' || printf 'Error: GitHub returned an unexpected response.\n' >&2
    return 1
  fi
  rm -f "$response_file"
  if [[ ! "$latest" =~ ^v?(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
    [[ "$mode" == "--json" ]] && printf '{"error":"GitHub returned an invalid release tag"}\n' || printf 'Error: GitHub returned an invalid release tag.\n' >&2
    return 1
  fi
  url="https://github.com/bossofcoffee/founder-mode-coffee-cli/releases/tag/$latest"
  version_gt "$latest" "$VERSION" && available=true
  if [[ "$mode" == "--json" ]]; then
    printf '{"current":"%s","latest":"%s","update_available":%s,"url":"%s"}\n' \
      "$(json_escape "$VERSION")" "$(json_escape "${latest#v}")" "$available" "$(json_escape "$url")"
  elif [[ "$available" == true ]]; then
    printf 'Update available: %s -> %s\n' "$VERSION" "${latest#v}"
    printf 'Run: curl -fsSL https://foundermodecoffee.com/install.sh | bash\n'
    [[ -n "$url" ]] && printf '%s\n' "$url"
  else
    printf 'founder-mode-coffee %s is current.\n' "$VERSION"
  fi
}

run_config() {
  local action="${1:-}"
  local key="${2:-}"
  local value="${3:-}"
  local temp_file=""
  case "$action" in
    get)
      [[ "$key" == "api" ]] || { printf 'Error: config key must be "api".\n' >&2; return 2; }
      config_api
      ;;
    set)
      [[ "$key" == "api" && -n "$value" ]] || { printf 'Usage: %s config set api URL\n' "$PROGRAM" >&2; return 2; }
      valid_api_url "$value" || { printf 'Error: API URL must be a valid http:// or https:// URL.\n' >&2; return 2; }
      config_path_accessible || { printf 'Error: config path is not accessible: %s\n' "$CONFIG_FILE" >&2; return 1; }
      mkdir -p "$CONFIG_HOME" 2>/dev/null || { printf 'Error: could not create config directory: %s\n' "$CONFIG_HOME" >&2; return 1; }
      temp_file="$(mktemp "$CONFIG_HOME/config.XXXXXX" 2>/dev/null)" || { printf 'Error: could not create config file in %s\n' "$CONFIG_HOME" >&2; return 1; }
      if ! printf 'api=%s\n' "${value%/}" > "$temp_file"; then
        rm -f "$temp_file"
        printf 'Error: could not write config file: %s\n' "$CONFIG_FILE" >&2
        return 1
      fi
      chmod 600 "$temp_file" 2>/dev/null || true
      if ! mv "$temp_file" "$CONFIG_FILE"; then
        rm -f "$temp_file"
        printf 'Error: could not replace config file: %s\n' "$CONFIG_FILE" >&2
        return 1
      fi
      printf 'Saved api in %s\n' "$CONFIG_FILE"
      ;;
    path)
      printf '%s\n' "$CONFIG_FILE"
      ;;
    reset)
      config_path_accessible || { printf 'Error: config path is not accessible: %s\n' "$CONFIG_FILE" >&2; return 1; }
      rm -f "$CONFIG_FILE" || { printf 'Error: could not reset config file: %s\n' "$CONFIG_FILE" >&2; return 1; }
      printf 'Configuration reset.\n'
      ;;
    *)
      printf 'Usage: %s config <get api|set api URL|path|reset>\n' "$PROGRAM" >&2
      return 2
      ;;
  esac
}

GLOBAL_JSON=false
while (($#)); do
  case "$1" in
    --json) GLOBAL_JSON=true; shift ;;
    --no-color) export NO_COLOR=1; shift ;;
    -h|--help) show_help; exit 0 ;;
    -V|--version) printf '%s %s\n' "$PROGRAM" "$VERSION"; exit 0 ;;
    --) shift; break ;;
    -*) printf 'Error: unknown option: %s\n' "$1" >&2; exit 2 ;;
    *) break ;;
  esac
done

init_colors
COMMAND="${1:-today}"
(($#)) && shift
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  if (($# > 1)); then
    printf 'Error: %s --help does not accept arguments.\n' "$COMMAND" >&2
    exit 2
  fi
  show_command_help "$COMMAND"
  exit $?
fi
case "$COMMAND" in
  ping|status|doctor|update)
    if (($# > 1)) || [[ -n "${1:-}" && "${1:-}" != "--json" ]]; then
      printf 'Error: unknown option for %s: %s\n' "$COMMAND" "${1:-}" >&2
      exit 2
    fi
    ;;
  hello)
    if (($#)); then
      printf 'Error: hello does not accept arguments.\n' >&2
      exit 2
    fi
    ;;
  capture)
    (($#)) || { printf 'Usage: %s capture TEXT\n' "$PROGRAM" >&2; exit 2; }
    ;;
  today)
    if (($# > 1)) || [[ -n "${1:-}" && "${1:-}" != "--json" ]]; then
      printf 'Error: unknown option for today: %s\n' "${1:-}" >&2
      exit 2
    fi
    ;;
  done)
    (($# == 1)) || { printf 'Usage: %s done ID\n' "$PROGRAM" >&2; exit 2; }
    ;;
  prompt|ask)
    (($#)) || { printf 'Usage: %s %s TEXT\n' "$PROGRAM" "$COMMAND" >&2; exit 2; }
    ;;
  focus)
    case "${1:-}" in
      set) (($# >= 2)) || { printf 'Usage: %s focus set TEXT\n' "$PROGRAM" >&2; exit 2; } ;;
      show|clear) (($# == 1)) || { printf 'Error: focus %s does not accept arguments.\n' "$1" >&2; exit 2; } ;;
      *) printf 'Usage: %s focus <set TEXT|show|clear>\n' "$PROGRAM" >&2; exit 2 ;;
    esac
    ;;
  config)
    case "${1:-}" in
      get) (($# == 2)) || { printf 'Usage: %s config get api\n' "$PROGRAM" >&2; exit 2; } ;;
      set) (($# == 3)) || { printf 'Usage: %s config set api URL\n' "$PROGRAM" >&2; exit 2; } ;;
      path|reset) (($# == 1)) || { printf 'Error: config %s does not accept arguments.\n' "$1" >&2; exit 2; } ;;
    esac
    ;;
  completion)
    (($# == 1)) || { printf 'Usage: %s completion <bash|zsh|fish>\n' "$PROGRAM" >&2; exit 2; }
    ;;
  help)
    (($# <= 1)) || { printf 'Usage: %s help [command]\n' "$PROGRAM" >&2; exit 2; }
    ;;
esac
MODE=""
if [[ "$GLOBAL_JSON" == true || "${1:-}" == "--json" ]]; then
  MODE="--json"
fi

case "$COMMAND" in
  help)
    show_command_help "${1:-}"
    ;;
  hello)
    show_hello
    ;;
  capture)
    run_capture "$@"
    ;;
  today)
    run_today "$MODE"
    ;;
  done)
    run_done "$1"
    ;;
  prompt)
    run_prompt "$@"
    ;;
  ask)
    run_ask "$@"
    ;;
  focus)
    run_focus "$@"
    ;;
  config)
    run_config "${1:-}" "${2:-}" "${3:-}"
    ;;
  status)
    run_status "$MODE"
    ;;
  ping)
    run_ping "$MODE"
    ;;
  doctor)
    run_doctor "$MODE"
    ;;
  completion)
    run_completion "${1:-}"
    ;;
  update)
    run_update "$MODE"
    ;;
  *)
    printf 'Error: unknown command: %s\n' "$COMMAND" >&2
    printf 'Run "%s --help" to see available commands.\n' "$PROGRAM" >&2
    exit 2
    ;;
esac
