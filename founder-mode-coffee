    '(-h --help)'{-h,--help}'[show help]' \
    '(-V --version)'{-V,--version}'[show version]' \
    '--json[print JSON]' \
    '--no-color[disable color]' \
    '1:command:(interactive capture focus today done prompt ask hello ping network online offline me checkin net status doctor config completion update help)'
}
_founder-mode-coffee "$@"
EOF
      ;;
    fish)
      cat <<'EOF'
complete -c founder-mode-coffee -f
complete -c founder-mode-coffee -s h -l help -d 'Show help'
complete -c founder-mode-coffee -s V -l version -d 'Show version'
complete -c founder-mode-coffee -l json -d 'Print JSON'
complete -c founder-mode-coffee -l no-color -d 'Disable color'
complete -c founder-mode-coffee -n '__fish_use_subcommand' -a 'interactive capture focus today done prompt ask hello ping network online offline me checkin net status doctor config completion update help'
EOF
      ;;
    *)
      printf 'Usage: %s completion <bash|zsh|fish>\n' "$PROGRAM" >&2
      return 2
      ;;
  esac
}

version_gt() {
  local LC_ALL=C
  local left="${1#v}" right="${2#v}" i av bv
  local -a a b
  IFS=. read -r -a a <<< "$left"
  IFS=. read -r -a b <<< "$right"
  for i in 0 1 2; do
    av="${a[$i]:-0}"
    bv="${b[$i]:-0}"
    ((${#av} > ${#bv})) && return 0
    ((${#av} < ${#bv})) && return 1
    [[ "$av" > "$bv" ]] && return 0
    [[ "$av" < "$bv" ]] && return 1
  done
  return 1
}

run_update() {
  local mode="${1:-}" response_file latest url available=false
  command -v curl >/dev/null 2>&1 || {
    [[ "$mode" == "--json" ]] && printf '{"error":"curl is required"}\n' || printf 'Error: curl is required for update checks.\n' >&2
    return 1
  }
  response_file="$(mktemp "${TMPDIR:-/tmp}/fmc-update-response.XXXXXX")" || {
    [[ "$mode" == "--json" ]] && printf '{"error":"update check failed"}\n' || printf 'Error: update check failed.\n' >&2
    return 1
  }
  if ! curl --globoff --fail --silent --show-error --connect-timeout 5 --max-time 15 -- \
      "https://api.github.com/repos/bossofcoffee/founder-mode-coffee-cli/releases/latest" > "$response_file"; then
    rm -f "$response_file"
    [[ "$mode" == "--json" ]] && printf '{"error":"update check failed"}\n' || printf 'Error: update check failed.\n' >&2
    return 1
  fi
  if capture_json_top_value "$response_file" tag_name string; then
    latest="$JSON_VALUE"
  else
    rm -f "$response_file"
    [[ "$mode" == "--json" ]] && printf '{"error":"GitHub returned an unexpected response"}\n' || printf 'Error: GitHub returned an unexpected response.\n' >&2
    return 1
  fi
  rm -f "$response_file"
  if [[ ! "$latest" =~ ^v?(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
    [[ "$mode" == "--json" ]] && printf '{"error":"GitHub returned an invalid release tag"}\n' || printf 'Error: GitHub returned an invalid release tag.\n' >&2
    return 1
  fi
  url="https://github.com/bossofcoffee/founder-mode-coffee-cli/releases/tag/$latest"
  version_gt "$latest" "$VERSION" && available=true
  if [[ "$mode" == "--json" ]]; then
    printf '{"current":"%s","latest":"%s","update_available":%s,"url":"%s"}\n' \
      "$(json_escape "$VERSION")" "$(json_escape "${latest#v}")" "$available" "$(json_escape "$url")"
  elif [[ "$available" == true && "${UPDATE_INSTALL:-false}" == true ]]; then
    install_update "$latest"
  elif [[ "$available" == true ]]; then
    printf 'Update available: %s -> %s\n' "$VERSION" "${latest#v}"
    printf 'Run: curl -fsSL https://foundermodecoffee.com/install.sh | bash\n'
    [[ -n "$url" ]] && printf '%s\n' "$url"
  else
    printf 'founder-mode-coffee %s is current.\n' "$VERSION"
  fi
}

install_update() (
  set -e
  local tag="$1" target="${BASH_SOURCE[0]}" dir stage temp archive expected actual member details
  [[ "$target" == /* ]] || target="$PWD/$target"
  # Never modify managed symlinks, source checkouts, or Cellar packages.
  if [[ -L "$target" || "$target" == */Cellar/* ]]; then
    printf 'Error: managed/symlink install; use brew upgrade bossofcoffee/founder-mode-coffee/founder-mode-coffee or reinstall to a user-owned directory.\n' >&2; exit 1
  fi
  dir="$(cd "$(dirname "$target")" && pwd -P)"
  if [[ "$dir" == */Cellar/* ]]; then
    printf 'Error: managed install directory; use brew upgrade instead.\n' >&2; exit 1
  fi
  if [[ -e "$dir/.git" ]]; then
    printf 'Error: refusing to overwrite a source checkout; install a release first.\n' >&2; exit 1
  fi
  [[ -w "$dir" && -f "$target" ]] || { printf 'Error: CLI install directory is not writable.\n' >&2; exit 1; }
  temp="$(mktemp -d "${TMPDIR:-/tmp}/fmc-update.XXXXXX")"
  stage=""
  trap 'rm -rf "$temp"; [[ -z "$stage" ]] || rm -f "$stage"' EXIT
  local name="founder-mode-coffee-${tag#v}.tar.gz"
  local base="https://github.com/bossofcoffee/founder-mode-coffee-cli/releases/download/$tag/$name"
  archive="$temp/$name"
  curl --globoff --fail --silent --show-error --location --connect-timeout 5 --max-time 60 --retry 2 -- "$base" > "$archive"
  expected="$(curl --globoff --fail --silent --show-error --location --connect-timeout 5 --max-time 20 -- "$base.sha256")"
  expected="${expected%% *}"
  [[ "$expected" =~ ^[a-f0-9]{64}$ ]] || { printf 'Error: release checksum is missing or invalid.\n' >&2; exit 1; }
  if command -v sha256sum >/dev/null 2>&1; then actual="$(sha256sum "$archive")";
  elif command -v shasum >/dev/null 2>&1; then actual="$(shasum -a 256 "$archive")";
  else printf 'Error: sha256sum or shasum is required.\n' >&2; exit 1; fi
  [[ "${actual%% *}" == "$expected" ]] || { printf 'Error: checksum verification failed; installed CLI unchanged.\n' >&2; exit 1; }
  while IFS= read -r member; do
    case "$member" in founder-mode-coffee|README.md|CHANGELOG.md|LICENSE) ;; *) printf 'Error: unsafe release archive.\n' >&2; exit 1 ;; esac
  done <<< "$(tar -tzf "$archive")"
  details="$(tar -tvzf "$archive")"
  while IFS= read -r member; do [[ "$member" == -* ]] || { printf 'Error: release archive contains non-regular files.\n' >&2; exit 1; }; done <<< "$details"
  stage="$(mktemp "$dir/.fmc-update.XXXXXX")"
  tar -xOzf "$archive" founder-mode-coffee > "$stage"
  bash -n "$stage"
  chmod 755 "$stage"
  [[ "$("$stage" --version)" == "$PROGRAM ${tag#v}" ]] || { printf 'Error: release version mismatch; installed CLI unchanged.\n' >&2; exit 1; }
  mv -f "$stage" "$target"
  stage=""
  printf 'Updated %s to %s\n' "$PROGRAM" "${tag#v}"
)

network_error() {
  if [[ "$MODE" == "--json" ]]; then
    printf '{"error":"%s"}\n' "$(json_escape "$1")"
  else
    printf 'Error: %s\n' "$1" >&2
  fi
  return 1
}

SESSION_DIR=""
RUNTIME_DIR=""
CURL_PID=""
WORKER_PID=""
REQUEST_PID=""
ONLINE_ACTIVE=false
LEASE_OWNED=false
HEARTBEAT_SECONDS=60
LEASE_SECONDS=300
ACCENT=""

ensure_identity() {
  local identity="$CONFIG_HOME/identity" seed token
  private_path "$identity" || { network_error 'Unsafe private identity destination'; return 1; }
  (umask 077; mkdir -p "$CONFIG_HOME") || return 1
  [[ -O "$CONFIG_HOME" ]] || { network_error 'Unsafe private identity directory'; return 1; }
  if [[ ! -e "$identity" ]]; then
    seed="$(umask 077; mktemp "$CONFIG_HOME/.identity.XXXXXX")" || return 1
    token="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
    if [[ ! "$token" =~ ^[a-f0-9]{64}$ ]] || ! printf '%s\n' "$token" > "$seed"; then
      rm -f "$seed"; network_error 'Could not create private identity'; return 1
    fi
    ln "$seed" "$identity" 2>/dev/null || true
    rm -f "$seed"
  fi
  [[ -f "$identity" && ! -L "$identity" && -O "$identity" && "$(file_metadata "$identity")" == '600 1' ]] || {
    network_error 'Unsafe private identity file'; return 1
  }
}

run_presence() {
  local action="${1:-presence}" output="${2:-quiet}" api token temp file code field value limit=15 method=POST
  local MODE="$MODE"
  [[ "$output" == --json ]] && MODE=--json
  if [[ "$action" == presence || "$action" == checkin ]]; then ensure_identity || exit 1; fi
  if ! private_path "$CONFIG_HOME/identity" || [[ ! -f "$CONFIG_HOME/identity" || ! -O "$CONFIG_HOME/identity" || "$(file_metadata "$CONFIG_HOME/identity")" != '600 1' ]]; then
    network_error 'No safe private identity; run founder-mode-coffee checkin first'; exit 1
  fi
  token="$(<"$CONFIG_HOME/identity")"
  [[ "$token" =~ ^[a-f0-9]{64}$ ]] || { network_error 'Private identity file is invalid'; exit 1; }
  api="$(resolved_api)" || { network_error 'Invalid API configuration'; exit 1; }
  command -v curl >/dev/null 2>&1 || { network_error 'curl is required'; exit 1; }
  temp="$(umask 077; mktemp -d "${TMPDIR:-/tmp}/fmc-presence.XXXXXX")" || exit 1
  file="$temp/response"
  trap 'if [[ -n "$CURL_PID" ]]; then kill "$CURL_PID" 2>/dev/null || true; wait "$CURL_PID" 2>/dev/null || true; fi; rm -rf "$temp"' EXIT
  trap 'exit 1' HUP INT TERM
  [[ "$action" == offline ]] && limit=2
  [[ "$action" != me ]] || method=GET
  # The credential is stdin data, never a curl argument. Do not follow auth redirects.
  curl --config - --globoff --silent --show-error --connect-timeout 2 --max-time "$limit" \
    -X "$method" --output "$file" --write-out '%{http_code}' -- "$api/network/$action" \
    <<< "header = \"Authorization: Bearer $token\"" > "$temp/code" 2>/dev/null || true
  code="$(<"$temp/code")"
  if [[ "$code" != 200 ]]; then
    [[ -z "$SESSION_DIR" || "$action" != presence ]] || printf 'unavailable\n' > "$SESSION_DIR/status"
    network_error 'FMC presence unavailable; try again later'; exit 1
  fi
  for field in status total_checkins first_seen last_seen; do
    value=string; [[ "$field" == total_checkins ]] && value=uint
    if ! capture_json_top_value "$file" "$field" "$value"; then
      network_error 'FMC presence returned an invalid response'; exit 1
    fi
    case "$field" in
      status)
        [[ ( "$action" != offline && "$JSON_VALUE" == ok ) || ( "$action" == offline && "$JSON_VALUE" == offline ) ]] || {
          network_error 'FMC presence returned an invalid status'; exit 1
        } ;;
      total_checkins) [[ "$JSON_VALUE" != 0 ]] || { network_error 'FMC presence returned an invalid count'; exit 1; } ;;
      first_seen|last_seen)
        valid_timestamp "$JSON_VALUE" || {
          network_error 'FMC presence returned an invalid timestamp'; exit 1
        } ;;
    esac
  done
  if [[ -n "$SESSION_DIR" && "$action" == presence ]]; then
    date +%s > "$temp/confirmed"
    mv "$temp/confirmed" "$SESSION_DIR/confirmed"
    printf 'ok\n' > "$SESSION_DIR/status"
  fi
  if [[ "$output" == --json ]]; then
    printf '{'
    local separator="" kind
    for field in status total_checkins first_seen last_seen; do
      kind=string; [[ "$field" == total_checkins ]] && kind=uint
      capture_json_top_value "$file" "$field" "$kind"
      printf '%s"%s":' "$separator" "$field"
      if [[ "$kind" == uint ]]; then printf '%s' "$JSON_VALUE"; else printf '"%s"' "$(json_escape "$JSON_VALUE")"; fi
      separator=,
    done
    printf '}\n'
  fi
  if [[ "$output" == "" ]]; then
    printf '\nYOUR FMC CONNECTION\n'
    for field in total_checkins first_seen last_seen; do
      value=string; [[ "$field" == total_checkins ]] && value=uint
      capture_json_top_value "$file" "$field" "$value"
      printf '  %-18s %s\n' "${field//_/ }" "$JSON_VALUE"
    done
  fi
  # Exit while locals still exist so the request cleanup trap owns its files.
  exit 0
}

refresh_presence() {
  local result=0
  (run_presence presence "${1:-quiet}") &
  REQUEST_PID=$!
  wait "$REQUEST_PID" || result=$?
  REQUEST_PID=""
  [[ $result -ne 0 ]] || LEASE_OWNED=true
  return "$result"
}

stop_worker() {
  if [[ -n "$WORKER_PID" ]]; then
    kill "$WORKER_PID" 2>/dev/null || true
    wait "$WORKER_PID" 2>/dev/null || true
    WORKER_PID=""
  fi
}

presence_worker() {
  local child=""
  trap 'if [[ -n "$child" ]]; then kill "$child" 2>/dev/null || true; wait "$child" 2>/dev/null || true; fi' EXIT
  trap 'exit 0' HUP INT TERM
  while :; do
    sleep "$HEARTBEAT_SECONDS" & child=$!
    wait "$child" || exit 0; child=""
    (run_presence presence) & child=$!
    if ! wait "$child"; then printf 'unavailable\n' > "$SESSION_DIR/status"; fi
    child=""
  done
}

run_online() {
  refresh_presence || return 1
  ONLINE_ACTIVE=true
  if [[ -z "$WORKER_PID" ]]; then
    (presence_worker) </dev/null >/dev/null 2>&1 & WORKER_PID=$!
  fi
  update_accent
  printf '%bOnline: presence confirmed; heartbeats every %ss.%b\n' "$ACCENT" "$HEARTBEAT_SECONDS" "$RESET"
}

run_offline() {
  stop_worker
  ONLINE_ACTIVE=false
  # Explicit intent can remove a lease from a previous one-shot invocation.
  # Unlike automatic cleanup, this does not require session ownership.
  if [[ -e "$CONFIG_HOME/identity" || -L "$CONFIG_HOME/identity" ]]; then
    (run_presence offline) & REQUEST_PID=$!
    wait "$REQUEST_PID" || true
    REQUEST_PID=""
  fi
  LEASE_OWNED=false
  [[ -z "$SESSION_DIR" ]] || rm -f "$SESSION_DIR/confirmed" "$SESSION_DIR/status"
  ACCENT="$AMBER"
  printf '%bOffline locally.%b\n' "$ACCENT" "$RESET"
}

session_cleanup() {
  trap - EXIT HUP INT TERM
  if [[ -n "$REQUEST_PID" ]]; then kill "$REQUEST_PID" 2>/dev/null || true; wait "$REQUEST_PID" 2>/dev/null || true; REQUEST_PID=""; fi
  stop_worker
  [[ "$LEASE_OWNED" != true ]] || (run_presence offline) >/dev/null 2>&1 || true
  [[ -z "$SESSION_DIR" ]] || rm -rf "$SESSION_DIR"
}

runtime_cleanup() {
  trap - EXIT HUP INT TERM
  stop_ai
  if [[ -n "$REQUEST_PID" ]]; then kill "$REQUEST_PID" 2>/dev/null || true; wait "$REQUEST_PID" 2>/dev/null || true; REQUEST_PID=""; fi
  if [[ -n "$CURL_PID" ]]; then kill "$CURL_PID" 2>/dev/null || true; wait "$CURL_PID" 2>/dev/null || true; CURL_PID=""; fi
  [[ -z "$SESSION_DIR" ]] || session_cleanup
  cleanup_ai_prompt
  [[ -z "$RUNTIME_DIR" ]] || rm -rf "$RUNTIME_DIR"
}

update_accent() {
  local confirmed=0 now
  ACCENT="$AMBER"
  if [[ "$ONLINE_ACTIVE" == true && -f "$SESSION_DIR/confirmed" ]]; then
    IFS= read -r confirmed < "$SESSION_DIR/confirmed" || true
    now="$(date +%s)"
    if [[ "$confirmed" =~ ^[0-9]{1,12}$ ]] && ((now >= confirmed && now - confirmed < LEASE_SECONDS)); then ACCENT="$GREEN"; fi
  fi
}

report_availability() {
  if [[ "$ONLINE_ACTIVE" == true && -f "$SESSION_DIR/status" && "$(<"$SESSION_DIR/status")" != ok ]]; then
    printf 'FMC presence unavailable; retrying. Green expires with the last confirmed lease.\n' >&2
  fi
}

run_network() {
  local api file field value
  refresh_presence || return 1
  api="$(resolved_api)" || return 1
  command -v curl >/dev/null 2>&1 || { network_error 'curl is required'; return 1; }
  file="$(mktemp "${TMPDIR:-/tmp}/fmc-network.XXXXXX")" || return 1
  if ! curl --globoff --fail --silent --show-error --location --connect-timeout 5 --max-time 15 -- "$api/network" > "$file" 2>/dev/null; then
    rm -f "$file"; network_error 'FMC network unavailable; try again later'; return 1
  fi
  for field in status timestamp online_users checked_in_users total_users total_checkins online_window_seconds; do
    case "$field" in status|timestamp) value=string ;; *) value=uint ;; esac
    if ! capture_json_top_value "$file" "$field" "$value"; then
      rm -f "$file"; network_error 'FMC network returned an invalid response'; return 1
    fi
    if ! validate_network_field "$field" "$JSON_VALUE"; then
      rm -f "$file"; network_error 'FMC network returned an invalid response'; return 1
    fi
  done
  if [[ "$MODE" == "--json" ]]; then
    emit_contract "$file" status timestamp online_users checked_in_users total_users total_checkins online_window_seconds
  else
    printf '\nFMC NETWORK\n'
    for field in status online_users checked_in_users total_users total_checkins online_window_seconds timestamp; do
      case "$field" in status|timestamp) value=string ;; *) value=uint ;; esac
      capture_json_top_value "$file" "$field" "$value"
      printf '  %-23s %s\n' "${field//_/ }" "$JSON_VALUE"
    done
    printf '\nCounts represent anonymous CLI installations, not verified people.\n'
  fi
  rm -f "$file"
}

run_net() {
  local interface="" gateway="" address="" route key value
  if command -v ip >/dev/null 2>&1; then
    route="$(ip -4 route show default 2>/dev/null)"
    read -r -a words <<< "$route"
    local i
    for ((i=0; i<${#words[@]}-1; i++)); do
      case "${words[$i]}" in via) gateway="${words[$((i+1))]}" ;; dev) interface="${words[$((i+1))]}" ;; esac
    done
    if [[ -n "$interface" ]]; then
      address="$(ip -o -4 address show dev "$interface" 2>/dev/null | awk '$3 == "inet" {split($4,a,"/"); print a[1]; exit}')"
    fi
  elif command -v route >/dev/null 2>&1 && command -v ifconfig >/dev/null 2>&1; then
    route="$(route -n get default 2>/dev/null)"
    interface="$(printf '%s\n' "$route" | awk '$1 == "interface:" {print $2; exit}')"
    gateway="$(printf '%s\n' "$route" | awk '$1 == "gateway:" {print $2; exit}')"
    [[ -n "$interface" ]] && address="$(ifconfig "$interface" 2>/dev/null | awk '$1 == "inet" {print $2; exit}')"
  fi
  if [[ "$MODE" == --json ]]; then
    printf '{'
    local separator=""
    for key in interface gateway local_address; do
      case "$key" in interface) value="$interface" ;; gateway) value="$gateway" ;; *) value="$address" ;; esac
      printf '%s"%s":' "$separator" "$key"
      if [[ -n "$value" ]]; then printf '"%s"' "$(json_escape "$value")"; else printf null; fi
      separator=,
    done
    printf '}\n'
  else
    printf '\nLOCAL NETWORK\n  interface      %s\n  gateway        %s\n  local address  %s\n' "${interface:-unavailable}" "${gateway:-unavailable}" "${address:-unavailable}"
    printf '\nRead-only; no LAN scan or public-IP lookup.\n'
  fi
}

run_config() {
  local action="${1:-}"
  local key="${2:-}"
  local value="${3:-}"
  local temp_file=""
  case "$action" in
    get)
      [[ "$key" == "api" ]] || { printf 'Error: config key must be "api".\n' >&2; return 2; }
      config_api
      ;;
    set)
      [[ "$key" == "api" && -n "$value" ]] || { printf 'Usage: %s config set api URL\n' "$PROGRAM" >&2; return 2; }
      valid_api_url "$value" || { printf 'Error: API URL must be a valid http:// or https:// URL.\n' >&2; return 2; }
      config_path_accessible || { printf 'Error: config path is not accessible: %s\n' "$CONFIG_FILE" >&2; return 1; }
      mkdir -p "$CONFIG_HOME" 2>/dev/null || { printf 'Error: could not create config directory: %s\n' "$CONFIG_HOME" >&2; return 1; }
      temp_file="$(mktemp "$CONFIG_HOME/config.XXXXXX" 2>/dev/null)" || { printf 'Error: could not create config file in %s\n' "$CONFIG_HOME" >&2; return 1; }
      if ! printf 'api=%s\n' "${value%/}" > "$temp_file"; then
        rm -f "$temp_file"
        printf 'Error: could not write config file: %s\n' "$CONFIG_FILE" >&2
        return 1
      fi
      chmod 600 "$temp_file" 2>/dev/null || true
      if ! mv "$temp_file" "$CONFIG_FILE"; then
        rm -f "$temp_file"
        printf 'Error: could not replace config file: %s\n' "$CONFIG_FILE" >&2
        return 1
      fi
      printf 'Saved api in %s\n' "$CONFIG_FILE"
      ;;
    path)
      printf '%s\n' "$CONFIG_FILE"
      ;;
    reset)
      config_path_accessible || { printf 'Error: config path is not accessible: %s\n' "$CONFIG_FILE" >&2; return 1; }
      rm -f "$CONFIG_FILE" || { printf 'Error: could not reset config file: %s\n' "$CONFIG_FILE" >&2; return 1; }
      printf 'Configuration reset.\n'
      ;;
    *)
      printf 'Usage: %s config <get api|set api URL|path|reset>\n' "$PROGRAM" >&2
      return 2
      ;;
  esac
}

GLOBAL_JSON=false
while (($#)); do
  case "$1" in
    --json) GLOBAL_JSON=true; shift ;;
    --no-color) export NO_COLOR=1; shift ;;
    -h|--help) show_help; exit 0 ;;
    -V|--version) printf '%s %s\n' "$PROGRAM" "$VERSION"; exit 0 ;;
    --) shift; break ;;
    -*) printf 'Error: unknown option: %s\n' "$1" >&2; exit 2 ;;
    *) break ;;
  esac
done

init_colors
if (($# == 0)) && [[ "$GLOBAL_JSON" != true && ( "${FMC_FORCE_INTERACTIVE:-0}" == "1" || ( -t 0 && -t 1 ) ) ]]; then
  COMMAND="interactive"
else
  COMMAND="${1:-today}"
fi
(($#)) && shift
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  if (($# > 1)); then
    printf 'Error: %s --help does not accept arguments.\n' "$COMMAND" >&2
    exit 2
  fi
  show_command_help "$COMMAND"
  exit $?
fi
UPDATE_INSTALL=false
case "$COMMAND" in
  update)
    case "${1:-}" in
      --install)
        [[ "$GLOBAL_JSON" == false && $# == 1 ]] || { printf 'Error: update --install cannot be combined with JSON or other options.\n' >&2; exit 2; }
        UPDATE_INSTALL=true; shift ;;
      --check) shift ;;
    esac
    if (($# > 1)) || [[ -n "${1:-}" && "${1:-}" != --json ]]; then
      printf 'Error: unknown option for update: %s\n' "${1:-}" >&2; exit 2
    fi
    ;;
  ping|status|doctor|network|me|checkin|net|online|offline)
    if (($# > 1)) || [[ -n "${1:-}" && "${1:-}" != "--json" ]]; then
      printf 'Error: unknown option for %s: %s\n' "$COMMAND" "${1:-}" >&2
      exit 2
    fi
    ;;
  hello)
    if (($#)); then
      printf 'Error: hello does not accept arguments.\n' >&2
      exit 2
    fi
    ;;
  capture)
    (($#)) || { printf 'Usage: %s capture TEXT\n' "$PROGRAM" >&2; exit 2; }
    ;;
  today)
    if (($# > 1)) || [[ -n "${1:-}" && "${1:-}" != "--json" ]]; then
      printf 'Error: unknown option for today: %s\n' "${1:-}" >&2
      exit 2
    fi
    ;;
  interactive)
    (($# == 0)) || { printf 'Error: interactive does not accept arguments.\n' >&2; exit 2; }
    ;;
  done)
    (($# == 1)) || { printf 'Usage: %s done ID\n' "$PROGRAM" >&2; exit 2; }
    ;;
  prompt|ask)
    (($#)) || { printf 'Usage: %s %s TEXT\n' "$PROGRAM" "$COMMAND" >&2; exit 2; }
    ;;
  focus)
    case "${1:-}" in
      set) (($# >= 2)) || { printf 'Usage: %s focus set TEXT\n' "$PROGRAM" >&2; exit 2; } ;;
      show|clear) (($# == 1)) || { printf 'Error: focus %s does not accept arguments.\n' "$1" >&2; exit 2; } ;;
      *) printf 'Usage: %s focus <set TEXT|show|clear>\n' "$PROGRAM" >&2; exit 2 ;;
    esac
    ;;
  config)
    case "${1:-}" in
      get) (($# == 2)) || { printf 'Usage: %s config get api\n' "$PROGRAM" >&2; exit 2; } ;;
      set) (($# == 3)) || { printf 'Usage: %s config set api URL\n' "$PROGRAM" >&2; exit 2; } ;;
      path|reset) (($# == 1)) || { printf 'Error: config %s does not accept arguments.\n' "$1" >&2; exit 2; } ;;
    esac
    ;;
  completion)
    (($# == 1)) || { printf 'Usage: %s completion <bash|zsh|fish>\n' "$PROGRAM" >&2; exit 2; }
    ;;
  help)
    (($# <= 1)) || { printf 'Usage: %s help [command]\n' "$PROGRAM" >&2; exit 2; }
    ;;
esac
MODE=""
if [[ "$GLOBAL_JSON" == true || "${1:-}" == "--json" ]]; then
  MODE="--json"
fi

umask 077
RUNTIME_DIR="$(mktemp -d "${TMPDIR:-/tmp}/fmc-private.XXXXXX")" || { network_error 'Could not create private temporary directory'; exit 1; }
TMPDIR="$RUNTIME_DIR"
export TMPDIR
trap 'runtime_cleanup' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
case "$COMMAND" in
  network|online|offline|me|checkin|ping|doctor)
    resolved_api >/dev/null 2>&1 || { network_error 'Invalid API configuration; remote API requires HTTPS'; exit 1; } ;;
esac

case "$COMMAND" in
  online)
    if [[ "$MODE" == --json ]]; then refresh_presence --json
    else run_interactive online; fi ;;
  offline)
    (run_presence offline "$MODE") & REQUEST_PID=$!
    wait "$REQUEST_PID"; result=$?; REQUEST_PID=""; exit "$result" ;;
  network) run_network ;;
  me|checkin)
    (run_presence "$COMMAND" "$MODE") & REQUEST_PID=$!
    wait "$REQUEST_PID"; result=$?; REQUEST_PID=""; exit "$result" ;;
  net) run_net ;;
  help)
    show_command_help "${1:-}"
    ;;
  hello)
    show_hello
    ;;
  capture)
    run_capture "$@"
    ;;
  today)
    run_today "$MODE"
    ;;
  interactive)
    run_interactive
    ;;
  done)
    run_done "$1"
    ;;
  prompt)
    run_prompt "$@"
    ;;
  ask)
    run_ask "$@"
    ;;
  focus)
    run_focus "$@"
    ;;
  config)
    run_config "${1:-}" "${2:-}" "${3:-}"
    ;;
  status)
    run_status "$MODE"
    ;;
  ping)
    run_ping "$MODE"
    ;;
  doctor)
    run_doctor "$MODE"
    ;;
  completion)
    run_completion "${1:-}"
    ;;
  update)
    run_update "$MODE"
    ;;
  *)
    printf 'Error: unknown command: %s\n' "$COMMAND" >&2
    printf 'Run "%s --help" to see available commands.\n' "$PROGRAM" >&2
    exit 2
    ;;
esac
