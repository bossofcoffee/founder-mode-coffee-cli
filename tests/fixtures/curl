#!/usr/bin/env bash
set -u

if [[ -n "${MOCK_CURL_LOG:-}" ]]; then
  printf '%s\n' "$*" >> "$MOCK_CURL_LOG"
  for arg in "$@"; do
    printf 'ARG=%s\n' "$arg" >> "$MOCK_CURL_LOG"
  done
fi

globoff=false
url=""
for arg in "$@"; do
  case "$arg" in
    -g|--globoff) globoff=true ;;
    http://*|https://*) url="$arg" ;;
  esac
done
if [[ -n "${MOCK_CURL_LOG:-}" && "$url" == *\{*,*\}* ]]; then
  if [[ "$globoff" == true ]]; then
    printf 'REQUEST=%s\n' "$url" >> "$MOCK_CURL_LOG"
  else
    prefix="${url%%\{*}"
    choices="${url#*\{}"
    choices="${choices%%\}*}"
    suffix="${url#*\}}"
    printf 'REQUEST=%s%s%s\n' "$prefix" "${choices%%,*}" "$suffix" >> "$MOCK_CURL_LOG"
    printf 'REQUEST=%s%s%s\n' "$prefix" "${choices#*,}" "$suffix" >> "$MOCK_CURL_LOG"
  fi
fi

if [[ "${MOCK_CURL_FAIL:-0}" == "1" ]]; then
  printf 'mock connection refused\n' >&2
  exit 7
fi
if [[ "${MOCK_CURL_CONTROL_ERROR:-0}" == "1" ]]; then
  printf 'bad\001\t\r\037\177error\n' >&2
  exit 7
fi
if [[ "${MOCK_CURL_INVALID:-0}" == "1" ]]; then
  printf 'not-json\n'
  exit 0
fi
if [[ "${MOCK_CURL_NUL_RESPONSE:-0}" == "1" ]]; then
  printf '{"message":"po\000ng"}\n'
  exit 0
fi
if [[ "${MOCK_CURL_NUL_UPDATE:-0}" == "1" ]]; then
  printf '{"tag_name":"v2.0.\0001"}\n'
  exit 0
fi
if [[ -n "${MOCK_CURL_RESPONSE:-}" ]]; then
  printf '%s\n' "$MOCK_CURL_RESPONSE"
  exit 0
fi

args=" $* "
case "$args" in
  *"/pings/locations"*)
    printf '{"total":42,"locations":[]}\n'
    ;;
  *"/ping"*)
    printf '{"message":"pong","timestamp":"2026-01-02T03:04:05Z","total_pings":42}\n'
    ;;
  *"api.github.com/repos/bossofcoffee/founder-mode-coffee-cli/releases/latest"*)
    printf '%s\n' '{' \
      '  "html_url": "https://github.com/bossofcoffee/founder-mode-coffee-cli/releases/tag/v2.1.0",' \
      '  "author": {"html_url": "https://github.com/example-author"},' \
      '  "tag_name": "v2.1.0",' \
      '  "assets": [{"uploader": {"html_url": "https://github.com/example-uploader"}}]' \
      '}'
    ;;
  *)
    printf '{}\n'
    ;;
esac
