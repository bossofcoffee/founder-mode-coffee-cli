#!/usr/bin/env bash
set -eu
url="${!#}"
case "$url" in
  */releases/latest) printf '{"tag_name":"v2.5.0"}\n' ;;
  *.tar.gz.sha256)
    if [[ "${MOCK_CORRUPT:-0}" == 1 ]]; then printf '%064d\n' 0;
    elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$MOCK_UPDATE_ARCHIVE" | cut -d' ' -f1;
    else shasum -a 256 "$MOCK_UPDATE_ARCHIVE" | cut -d' ' -f1; fi ;;
  *.tar.gz) command cat "$MOCK_UPDATE_ARCHIVE" ;;
  *) exit 22 ;;
esac
